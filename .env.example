# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA cometa o arquivo .env de verdade no Git.

# --- Modo de desenvolvimento (sem credenciais OCI) ---
# true = usa embeddings locais (sentence-transformers) e não chama LLM de verdade
# false = usa OCI Generative AI (necessário para o deploy final)
USE_LOCAL_FALLBACK=true

# --- OCI Generative AI ---
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxx
OCI_GENAI_ENDPOINT=https://inference.generativeai.sa-saopaulo-1.oci.oraclecloud.com
OCI_EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
OCI_LLM_MODEL_ID=cohere.command-r-plus

# --- OCI Object Storage ---
OCI_OBJECT_STORAGE_NAMESPACE=seu-namespace
OCI_OBJECT_STORAGE_BUCKET=agente-corporativo-docs
OCI_OBJECT_STORAGE_LOGS_BUCKET=agente-corporativo-logs
